# Monitoring only. Existing LINE/Firebase/Google settings are also required.
# .env is not loaded automatically; provide these as environment variables.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Normally derived from the repository name and RENDER_GIT_COMMIT.
# SENTRY_RELEASE=line-bot-features@<commit-sha>
# SENTRY_AUTH_TOKEN is for local API administration only; never deploy it.
